{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 31, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {"CPM_SOURCE_CACHE": "${sourceDir}/.cache/CPM"}
    },
    {
      "name": "dev",
      "displayName": "Debug build with tests and application",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "release",
      "displayName": "Optimized build",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    },
    {
      "name": "ci",
      "displayName": "CI: optimized, warnings as errors",
      "inherits": "base",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "RelWithDebInfo", "SILICONFORGE_WARNINGS_AS_ERRORS": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "dev", "configurePreset": "dev"},
    {"name": "release", "configurePreset": "release"},
    {"name": "ci", "configurePreset": "ci"}
  ],
  "testPresets": [
    {"name": "dev", "configurePreset": "dev", "output": {"outputOnFailure": true}},
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "ci", "configurePreset": "ci", "output": {"outputOnFailure": true}}
  ]
}
