{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://siliconforge.dev/schemas/component-v1.schema.json",
  "title": "SiliconForge component description v1",
  "type": "object",
  "required": ["formatVersion", "type", "name", "terminals", "properties", "footprint", "model", "state"],
  "additionalProperties": false,
  "properties": {
    "formatVersion": {"const": 1},
    "type": {"$ref": "#/definitions/identifier"},
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "terminals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["name"],
        "additionalProperties": false,
        "properties": {
          "name": {"$ref": "#/definitions/identifier"},
          "role": {"enum": ["passive", "bus"], "default": "passive"},
          "bus": {"type": "string", "minLength": 1}
        }
      }
    },
    "properties": {
      "type": "object",
      "propertyNames": {"$ref": "#/definitions/identifier"},
      "additionalProperties": {"$ref": "#/definitions/property"}
    },
    "footprint": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {"kind": {"const": "free"}}
        },
        {
          "type": "object",
          "required": ["kind", "minimum", "maximum"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "span"},
            "minimum": {"type": "integer", "minimum": 1, "maximum": 512},
            "maximum": {"type": "integer", "minimum": 1, "maximum": 512}
          }
        },
        {
          "type": "object",
          "required": ["kind", "offsets"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "fixed"},
            "offsets": {
              "type": "object",
              "propertyNames": {"$ref": "#/definitions/identifier"},
              "additionalProperties": {
                "type": "array",
                "items": {"type": "integer", "minimum": -512, "maximum": 512},
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "required": ["elements"],
      "additionalProperties": false,
      "properties": {
        "elements": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "required": ["type", "between"],
            "additionalProperties": false,
            "properties": {
              "type": {"enum": ["wire", "resistor", "led", "switch", "potentiometer"]},
              "name": {"$ref": "#/definitions/identifier"},
              "between": {
                "type": "array",
                "items": {"$ref": "#/definitions/identifier"},
                "minItems": 2,
                "maxItems": 3
              }
            }
          }
        }
      }
    },
    "state": {
      "type": "object",
      "propertyNames": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*(\\.[a-z][a-zA-Z0-9-]*)?$"},
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["number", "boolean", "bytes"]},
          "minimum": {"type": "number"},
          "maximum": {"type": "number"},
          "default": {"type": ["number", "boolean"]},
          "interactive": {"type": "boolean", "default": false},
          "description": {"type": "string"}
        }
      }
    }
  },
  "definitions": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-zA-Z0-9-]*$", "maxLength": 64},
    "property": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "default"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "number"},
            "unit": {"type": "string", "minLength": 1},
            "default": {"type": "number"},
            "minimum": {"type": "number"},
            "maximum": {"type": "number"},
            "description": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["type", "default"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "string"},
            "default": {"type": "string"},
            "enum": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
            "description": {"type": "string"}
          }
        },
        {
          "type": "object",
          "required": ["type", "default"],
          "additionalProperties": false,
          "properties": {
            "type": {"const": "boolean"},
            "default": {"type": "boolean"},
            "description": {"type": "string"}
          }
        }
      ]
    }
  }
}
