+// At OCR0A = 0, Fast PWM still drives the pin high for one timer count per period: 0 % disconnects OC0A instead and
+// leaves D6 low through PORTD.
+static void setDuty(uint8_t percent) {
+    if (percent == 0) {
+        TCCR0A &= ~_BV(COM0A1);
+        PORTD &= ~_BV(PORTD6);
+    } else {
+        OCR0A = compareFor(percent);
+        TCCR0A |= _BV(COM0A1);
+    }
+}
