file(MAKE_DIRECTORY "${WORK}/results/programs")

function(run expect)
    execute_process(COMMAND "${TOOL}" ${ARGN}
        RESULT_VARIABLE actual ERROR_VARIABLE err OUTPUT_VARIABLE out)
    if(NOT actual STREQUAL expect)
        message(FATAL_ERROR "${ARGN}: exit ${actual}, expected ${expect}\n${out}\n${err}")
    endif()
endfunction()

run(0 cycles --mcu atmega328p --out "${WORK}/results/cycles.json")
run(0 cycles --mcu atmega2560 --out "${WORK}/results/cycles-atmega2560.json")
run(0 cycles --mcu attiny424 --out "${WORK}/results/cycles-attiny424.json")
# The matrix must discard evidence with another target, or with no target identifier.
file(WRITE "${WORK}/results/differential.json" [=[{"mcu":"atmega328p"}]=])
file(WRITE "${WORK}/results/programs/foreign.json" [=[{"mcu":"ATmega328P","status":"pass"}]=])
file(WRITE "${WORK}/results/programs/untagged.json" [=[{"status":"pass"}]=])

foreach(chip IN ITEMS atmega2560 attiny424)
    run(1 matrix --mcu "${chip}" --results "${WORK}/results" --out "${WORK}/matrix")
    file(READ "${WORK}/matrix/${chip}.matrix.json" matrix)
    string(JSON programs GET "${matrix}" programs)
    if(NOT programs EQUAL 0)
        message(FATAL_ERROR "${chip}: matrix counts programs from another target")
    endif()
    string(JSON count LENGTH "${matrix}" rows)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON mnemonic GET "${matrix}" rows ${index} mnemonic)
        string(JSON differential GET "${matrix}" rows ${index} differential)
        if(NOT differential STREQUAL "missing")
            message(FATAL_ERROR "${chip}: matrix attributes differential evidence to ${mnemonic}")
        endif()
        string(JSON cycles GET "${matrix}" rows ${index} cycles)
        if(chip STREQUAL "attiny424" AND mnemonic MATCHES "^(call|jmp|spm)$")
            message(FATAL_ERROR "ATtiny424: matrix includes unsupported instruction ${mnemonic}")
        elseif(chip STREQUAL "attiny424" AND NOT cycles STREQUAL "missing")
            message(FATAL_ERROR "ATtiny424: consistency check qualified ${mnemonic}")
        elseif(chip STREQUAL "atmega2560" AND mnemonic STREQUAL "elpm" AND NOT cycles STREQUAL "pass")
            message(FATAL_ERROR "ATmega2560: qualified ELPM timings are missing")
        endif()
    endforeach()
endforeach()

file(READ "${WORK}/matrix/README.md" index)
foreach(chip IN ITEMS atmega2560 attiny424)
    string(FIND "${index}" "](${chip}.md)" link)
    if(link EQUAL -1)
        message(FATAL_ERROR "Qualification index does not link to ${chip}")
    endif()
endforeach()

file(STRINGS "${WORK}/matrix/atmega2560.md" callLine ENCODING UTF-8 REGEX "^\\| `call` \\|")
if(NOT callLine MATCHES "✅ 5 \\|")
    message(FATAL_ERROR "ATmega2560: missing five-cycle CALL measurement: ${callLine}")
endif()

file(READ "${WORK}/results/cycles-attiny424.json" tiny)
string(JSON mode GET "${tiny}" mode)
string(JSON reference TYPE "${tiny}" reference)
if(NOT mode STREQUAL "consistency" OR NOT reference STREQUAL "NULL")
    message(FATAL_ERROR "ATtiny424: cycle report should be a consistency check without a manual reference")
endif()

foreach(instruction IN ITEMS call jmp spm)
    string(JSON result ERROR_VARIABLE absent GET "${tiny}" instructions "${instruction}")
    if(absent STREQUAL "NOTFOUND")
        message(FATAL_ERROR "ATtiny424: cycle sweep reports unsupported instruction ${instruction}")
    endif()
endforeach()

# On AVRxt, the base case must access GPIOR0 and the SRAM case must access the first SRAM byte.
# Cycles.cpp watches those addresses while stepping each fixture.
foreach(instruction IN ITEMS lds sts "ld -z" "st x+" push pop)
    string(JSON ioAddress GET "${tiny}" instructions "${instruction}" cases 0 dataAddress)
    string(JSON sramAddress GET "${tiny}" instructions "${instruction}" cases 1 dataAddress)
    if(NOT ioAddress EQUAL 28 OR NOT sramAddress EQUAL 15872)
        message(FATAL_ERROR "ATtiny424 ${instruction}: expected GPIOR0 and SRAM, got ${ioAddress} and ${sramAddress}")
    endif()
endforeach()
